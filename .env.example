# ==========================
# Academy - Variáveis de Ambiente (exemplo)
# Copie para .env.local (dev) ou /etc/academy.env (VPS, ver docs/deploy-vps.md)
# ==========================

# --- Supabase (obrigatório) ---
# Sem URL + ANON KEY, o middleware responde 503 em TODAS AS ROTAS não isentas
# (fail-closed: só assets passam). Nunca libera acesso sem autenticação.
NEXT_PUBLIC_SUPABASE_URL="https://your-project.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-anon-key"

# Service role: SOMENTE servidor. Nunca prefixar com NEXT_PUBLIC_.
# Vazou = banco inteiro aberto, RLS ignorada.
SUPABASE_SERVICE_ROLE_KEY="your-service-role-key"

# --- Email (Resend) ---
RESEND_API_KEY="re_xxx"
RESEND_FROM_EMAIL="Academy <nao-responda@seu-dominio.com.br>"
# Se preenchida, TODO email de saída é redirecionado para este endereço.
# Deixar VAZIA em produção.
RESEND_TEST_RECIPIENT=""

# --- Módulo de gestão interna (feature flag) ---
# Rota /gestao nasce DESLIGADA (fail-closed). Defina "true" para habilitar sem
# deploy. Vazio ou qualquer outro valor mantém o módulo desligado (404 na rota).
GESTAO_ENABLED=""

# --- URL absoluta (email, certificado, OAuth) ---
# Na Vercel, VERCEL_URL cobre. No VPS é obrigatória, com https e sem barra final.
NEXT_PUBLIC_APP_URL="https://academy.seu-dominio.com.br"

# --- Playwright (opcional; specs de auth pulam sem estas) ---
TEST_STUDENT_EMAIL=""
TEST_STUDENT_PASSWORD=""
TEST_TEACHER_EMAIL=""
TEST_TEACHER_PASSWORD=""
TEST_ADMIN_EMAIL=""
TEST_ADMIN_PASSWORD=""
