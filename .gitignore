# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*.local
.env

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# Playwright
node_modules/
/test-results/
/playwright-report/
/blob-report/
/playwright/.cache/
/playwright/.auth/

# Logs and reports
*.log
lint_*.txt

# OS generated files
Thumbs.db

# Local tool configs
.impeccable/

# Configuração local de editor/agente: costuma receber token literal
# (ver docs/decisions.md 014 e o corpo de ddad918). Servidor MCP compartilhado
# pelo time vai em `.mcp.json`, com o valor referenciado como ${VAR}.
.vscode/mcp.json
.claude/settings.local.json

# Worktrees de agente criados dentro do próprio repo (git não os ignora sozinho)
/.worktrees/

# Chave privada de deploy: nunca versionada (a pública vive nos secrets do CI)
/_chaves-deploy/

# Capturas de tela descartáveis geradas em teste (precisam de SNAP_OUT)
tests/**/_snap.test.tsx
